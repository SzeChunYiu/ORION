  "cases": [
    {
      "case_id": "CLEAN_BEARER_ADMIN",
      "description": "One JWT access-token record contains every required validation and authorization fact.",
      "expected_authorized": true,
      "expected_reason": "all bearer premises belong to one validated token coordinate",
      "mode": "bearer",
      "records": [
        {
          "coordinate": "tok:a|iss:trusted|sub:alice|aud:rs1",
          "facts": [
            "aud_rs1",
            "issuer_trusted",
            "not_expired",
            "scope_admin",
            "signature_valid",
            "subject_alice",
            "typ_at_jwt"
          ],
          "record_id": "token-a"
        }
      ],
      "refutations": []
    },
    {
      "case_id": "SAME_TOKEN_FRAGMENTATION_ALLOWED",
      "description": "Two validators emit complementary facts for the same content-bound token coordinate.",
      "expected_authorized": true,
      "expected_reason": "content-bound records for the same token may compose",
      "mode": "bearer",
      "records": [
        {
          "coordinate": "tok:a|iss:trusted|sub:alice|aud:rs1",
          "facts": [
            "issuer_trusted",
            "not_expired",
            "signature_valid",
            "typ_at_jwt"
          ],
          "record_id": "token-a-validation"
        },
        {
          "coordinate": "tok:a|iss:trusted|sub:alice|aud:rs1",
          "facts": [
            "aud_rs1",
            "scope_admin",
            "subject_alice"
          ],
          "record_id": "token-a-authorization"
        }
      ],
      "refutations": []
    },
    {
