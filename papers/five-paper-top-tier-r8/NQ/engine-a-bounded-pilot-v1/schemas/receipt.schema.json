{
  "$id": "urn:orion:nq-engine-a:receipt:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal": {
            "const": "ENGINEERING_NEGATIVE"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "certificate_valid": {
            "type": "null"
          },
          "exhaustive": {
            "const": true
          },
          "full_coverage": {
            "const": true
          },
          "result_status": {
            "const": "NEGATIVE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal": {
            "const": "ENGINEERING_POSITIVE"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "certificate_valid": {
            "const": true
          },
          "exhaustive": {
            "const": true
          },
          "result_status": {
            "const": "POSITIVE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal": {
            "const": "CANNOT_CHECK_RESOURCE_BOUND"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "exhaustive": {
            "const": false
          },
          "full_coverage": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "certificate_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "exhaustive": {
      "type": "boolean"
    },
    "exposure_markers": {
      "allOf": [
        {
          "contains": {
            "const": "EXPECTED_OUTCOME_EXPOSURE"
          }
        },
        {
          "contains": {
            "const": "ENGINE_B_EXPOSURE_IN_PRIOR_CONTEXT__CANNOT_CHECK"
          }
        }
      ],
      "items": {
        "enum": [
          "EXPECTED_OUTCOME_EXPOSURE",
          "ENGINE_B_EXPOSURE_IN_PRIOR_CONTEXT__CANNOT_CHECK"
        ]
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "full_coverage": {
      "type": "boolean"
    },
    "independence_terminal": {
      "const": "CANNOT_CHECK"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "frontier_peak": {
          "minimum": 0,
          "type": "integer"
        },
        "k": {
          "minimum": 1,
          "type": "integer"
        },
        "layers_completed": {
          "minimum": 0,
          "type": "integer"
        },
        "sequence_length": {
          "minimum": 0,
          "type": "integer"
        },
        "states_explored": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence_length",
        "k",
        "layers_completed",
        "states_explored",
        "frontier_peak"
      ],
      "type": "object"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_status": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "CANNOT_CHECK_RESOURCE_BOUND"
      ]
    },
    "schema_version": {
      "const": "nq-engine-a-receipt-v1"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "terminal": {
      "enum": [
        "ENGINEERING_POSITIVE",
        "ENGINEERING_NEGATIVE",
        "CANNOT_CHECK_RESOURCE_BOUND",
        "CANNOT_CHECK_INVALID_CERTIFICATE"
      ]
    }
  },
  "required": [
    "schema_version",
    "terminal",
    "independence_terminal",
    "exposure_markers",
    "input_sha256",
    "source_manifest_sha256",
    "result_sha256",
    "result_status",
    "full_coverage",
    "exhaustive",
    "certificate_valid",
    "reasons",
    "metrics"
  ],
  "title": "NQ Engine A fail-closed engineering receipt",
  "type": "object"
}
