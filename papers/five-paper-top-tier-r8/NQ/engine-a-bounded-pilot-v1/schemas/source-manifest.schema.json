{
  "$id": "urn:orion:nq-engine-a:source-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exposure_markers": {
      "allOf": [
        {
          "contains": {
            "const": "EXPECTED_OUTCOME_EXPOSURE"
          }
        },
        {
          "contains": {
            "const": "ENGINE_B_EXPOSURE_IN_PRIOR_CONTEXT__CANNOT_CHECK"
          }
        }
      ],
      "items": {
        "enum": [
          "EXPECTED_OUTCOME_EXPOSURE",
          "ENGINE_B_EXPOSURE_IN_PRIOR_CONTEXT__CANNOT_CHECK"
        ]
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "independence_terminal": {
      "const": "CANNOT_CHECK"
    },
    "schema_version": {
      "const": "nq-engine-a-source-manifest-v1"
    },
    "source_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "independence_terminal",
    "exposure_markers",
    "files",
    "source_tree_sha256"
  ],
  "title": "NQ Engine A deterministic source manifest",
  "type": "object"
}
