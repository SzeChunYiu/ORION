{
  "$id": "ORION.NQ.EngineB.CertificateSchemas.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "authority": {
    "sat_witness": "replayable finite predicate evidence",
    "unsat_hash_only": "not logical verification",
    "unsat_required": "external DRUP verification",
    "d4_c5_cubed": "OPEN"
  },
  "certificate_types": [
    "ORION.NQ.EngineB.SATCertificate.v1",
    "ORION.NQ.EngineB.UNSATCertificate.v1"
  ],
  "required_bindings": [
    "subject_commit",
    "record_id",
    "sequence_sha256",
    "required_bins",
    "cnf_sha256",
    "solver_identity",
    "certificate_sha256"
  ]
}
