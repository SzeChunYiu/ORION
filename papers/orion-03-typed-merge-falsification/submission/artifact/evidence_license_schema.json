{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:typed-evidence-licenses:finite-positive-rule-graphs:v1",
  "title": "Finite typed evidence-license rule graph",
  "$comment": "This schema validates document shape. The reference evaluator additionally enforces unique claim and rule identifiers plus referential integrity among claims, licenses, rule bodies, rule heads, rule caps, and refutations.",
  "x-semanticValidation": [
    "claim identifiers are unique",
    "rule identifiers are unique",
    "claim seed and rule-cap licenses are declared",
    "rule body, rule head, and refutation claims are declared"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "licenses", "claims", "rules", "refutations"],
  "properties": {
    "version": {"const": "1.0"},
    "licenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "seeds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "seeds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "body", "head", "cap"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "body": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "head": {"type": "string", "minLength": 1},
          "cap": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "refutations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
