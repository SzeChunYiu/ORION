{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion.p5.hidden-cause-case.v1",
  "title": "ORION-P5 hidden-cause development case V1",
  "type": "object",
  "required": ["case_id", "visible_symptom", "candidate_visible_context", "protected_root_cause", "motivating_tasks", "replay_tasks", "fresh_tasks", "allowed_change_surface", "protected_surface", "success_rubric"],
  "properties": {
    "case_id": {"type": "string"},
    "visible_symptom": {"type": "string"},
    "candidate_visible_context": {"type": "object"},
    "protected_root_cause": {"enum": ["RETRIEVAL_MISS", "ROUTING_PLANNING_MISS", "IMPLEMENTATION_BUG", "ENVIRONMENT_DEPENDENCY_TOOL_FAILURE", "EVALUATOR_METRIC_BUG", "REPRESENTATION_GAP", "MEASUREMENT_SPECIFICATION_GAP", "METHOD_BASIS_GAP"]},
    "competing_cause_set": {"type": "array", "items": {"type": "string"}},
    "motivating_tasks": {"type": "array", "items": {"type": "string"}},
    "replay_tasks": {"type": "array", "items": {"type": "string"}},
    "fresh_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "changed_axes", "content_hash"],
        "properties": {
          "task_id": {"type": "string"},
          "changed_axes": {"type": "array", "minItems": 1, "items": {"enum": ["TASK", "DOMAIN", "MODEL", "ENVIRONMENT", "DATA", "TOOL"]}},
          "content_hash": {"type": "string"}
        }
      }
    },
    "allowed_change_surface": {"type": "array", "items": {"type": "string"}},
    "protected_surface": {"type": "array", "items": {"type": "string"}},
    "success_rubric": {"type": "string"},
    "harm_rubric": {"type": "string"},
    "evaluator_hash": {"type": "string"},
    "case_artifact_hash": {"type": "string"}
  }
}
