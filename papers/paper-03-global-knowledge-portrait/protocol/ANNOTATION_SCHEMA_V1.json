{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion.p3.annotation.v1",
  "title": "ORION-P3 cross-domain atlas annotation V1",
  "type": "object",
  "required": [
    "annotation_id", "case_id", "annotator_id", "annotation_round", "source_a", "source_b",
    "referent_relation", "construct_relation", "measurement_relation", "context_relation",
    "polarity_relation", "modality_relation", "attribution_relation", "discourse_relation",
    "mapping_relation", "preservation_conditions", "contradiction_verdict", "integration_verdict",
    "recoverability_target", "confidence", "rationale"
  ],
  "properties": {
    "annotation_id": {"type": "string"},
    "case_id": {"type": "string"},
    "annotator_id": {"type": "string"},
    "annotation_round": {"enum": ["INDEPENDENT", "ADJUDICATION", "DOMAIN_EXPERT_ESCALATION"]},
    "source_a": {"$ref": "#/$defs/source_span"},
    "source_b": {"$ref": "#/$defs/source_span"},
    "referent_relation": {"enum": ["SAME", "DIFFERENT", "PARTIAL_OVERLAP", "UNRESOLVED"]},
    "construct_relation": {"enum": ["SAME", "RELATED_NOT_SAME", "DIFFERENT", "UNRESOLVED"]},
    "measurement_relation": {"enum": ["EQUIVALENT", "TRANSFORMABLE_WITH_CONDITIONS", "NON_EQUIVALENT", "NOT_APPLICABLE", "UNRESOLVED"]},
    "context_relation": {"enum": ["ALIGNED", "CONDITIONED_COMPATIBLE", "DIFFERENT_STATE_OR_TIME", "INCOMPATIBLE", "UNRESOLVED"]},
    "polarity_relation": {"enum": ["SAME", "OPPOSITE", "NOT_COMPARABLE", "UNRESOLVED"]},
    "modality_relation": {"enum": ["SAME", "DIFFERENT_STRENGTH", "NOT_COMPARABLE", "UNRESOLVED"]},
    "attribution_relation": {"enum": ["SAME_SPEAKER_OR_SOURCE", "DIFFERENT_ATTRIBUTION", "NOT_APPLICABLE", "UNRESOLVED"]},
    "discourse_relation": {"enum": ["ALIGNED", "CONTEXTUAL_DIFFERENCE", "NOT_COMPARABLE", "UNRESOLVED"]},
    "mapping_relation": {"enum": ["IDENTITY", "EQUIVALENCE", "CONDITIONAL_TRANSFORM", "SUBSUMPTION", "ASSOCIATION_ONLY", "NO_LICENSED_MAPPING", "UNRESOLVED"]},
    "preservation_conditions": {"type": "array", "items": {"type": "string"}},
    "non_preserved_coordinates": {"type": "array", "items": {"type": "string"}},
    "contradiction_verdict": {"enum": ["CONTRADICTION", "NO_CONTRADICTION", "CONTEXT_DEPENDENT", "UNRESOLVED"]},
    "integration_verdict": {"enum": ["GLUE_ALLOWED", "OBSTRUCTION", "PLURAL_VIEW", "UNRESOLVED"]},
    "recoverability_target": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 1},
    "specialist_domain_required": {"type": "boolean"}
  },
  "$defs": {
    "source_span": {
      "type": "object",
      "required": ["document_id", "document_version", "span_start", "span_end", "text_hash"],
      "properties": {
        "document_id": {"type": "string"},
        "document_version": {"type": "string"},
        "span_start": {"type": "integer", "minimum": 0},
        "span_end": {"type": "integer", "minimum": 0},
        "text_hash": {"type": "string"},
        "discipline": {"type": "string"}
      }
    }
  }
}
