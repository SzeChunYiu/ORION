{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion.p7.navigation-contract.v2",
  "type": "object",
  "required": [
    "id",
    "family",
    "domain",
    "topology_change_required",
    "mandatory_obligations",
    "censored_regions",
    "negative_control",
    "expected_terminal",
    "gold"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "family": {
      "type": "string",
      "enum": [
        "hidden_useful_branch",
        "unknown_coverage",
        "censored_route",
        "deceptive_route_diversity",
        "dead_end_revisit",
        "topology_change",
        "unnecessary_reframe"
      ]
    },
    "domain": {"type": "string", "minLength": 1},
    "topology_change_required": {"type": "boolean"},
    "mandatory_obligations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "censored_regions": {"type": "array", "items": {"type": "string"}},
    "negative_control": {"type": "boolean"},
    "expected_terminal": {
      "type": "string",
      "enum": ["TASK_STOP", "ROUTE_STOP", "REFRAME", "DEFER", "CANNOT_CHECK"]
    },
    "gold": {"type": "object"}
  }
}
