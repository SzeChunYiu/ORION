{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion.invalid/schemas/p14-external-packet-v1.json",
  "title": "P14 External Blinded Research Packet V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "domain",
    "question",
    "visible_evidence",
    "allowed_tools",
    "resource_budget",
    "claim_language",
    "preregistered_decision_points",
    "gold_record_digest"
  ],
  "properties": {
    "schema_version": {"const": "P14_EXTERNAL_PACKET_V1"},
    "packet_id": {"type": "string", "minLength": 8},
    "domain": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "visible_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256", "role", "content_location"],
        "properties": {
          "artifact_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "enum": ["PRIMARY", "DONOR", "CONTROL", "PROTOCOL", "RESULT", "BACKGROUND"]},
          "content_location": {"type": "string"}
        }
      }
    },
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "resource_budget": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["integer", "number", "string"]}
    },
    "claim_language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_scope", "forbidden_promotions"],
      "properties": {
        "max_scope": {"type": "string"},
        "forbidden_promotions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "preregistered_decision_points": {"type": "array", "items": {"type": "string"}},
    "gold_record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
