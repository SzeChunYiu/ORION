{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion.journal-package.v1",
  "title": "ORION journal package V1",
  "description": "Gate 7–9 submission-package inventory. Distinct from issue #283 ScientificResultVerification.v1, which this schema consumes if present and never forks.",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "package_status",
    "declared_paper_terminal",
    "audit_subject_revision",
    "required_files",
    "missing_artifacts",
    "claims",
    "scientific_result_verification"
  ],
  "properties": {
    "schema_version": {"const": "orion.journal-package.v1"},
    "paper_id": {"enum": ["P1", "P2", "P3", "P4", "P5"]},
    "package_status": {
      "enum": ["SCAFFOLDING", "SUPERSEDED", "SUBMISSION_READY"],
      "description": "SCAFFOLDING has no PDF. SUPERSEDED retains a required and checksummed historical PDF whose generator-derived render state is SUPERSEDED, denies current submission authority, and keeps a current package claim OPEN. SUBMISSION_READY requires a compiled, checksummed current PDF and claim audit with every package-level missing artifact and OPEN claim closed. Filing-time DOI/editor operations may remain separately typed as submission operations."
    },
    "declared_paper_terminal": {"type": "string"},
    "audit_subject_revision": {"type": "string", "minLength": 40, "maxLength": 40},
    "package_authority": {
      "type": "object",
      "properties": {
        "current_submission_authorized": {"type": "boolean"}
      }
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string"},
          "role": {"type": "string"}
        }
      }
    },
    "missing_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "status", "reason"],
        "properties": {
          "path": {"type": "string"},
          "role": {"type": "string"},
          "status": {"const": "CANNOT_CHECK"},
          "reason": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "artifacts", "status"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "artifacts": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "BOUNDED", "CANNOT_CHECK", "OPEN"]},
          "lifecycle": {"enum": ["ACTIVE_CENTRAL", "ACTIVE_SUPPORTING", "HISTORICAL_IMMUTABLE"]},
          "current_claim": {"type": "boolean"},
          "design_adequacy": {"type": "string"},
          "narrower_successor": {"type": "string"},
          "scope_ceiling": {"type": "string"},
          "relationship_to_previous": {
            "type": "object",
            "properties": {
              "type": {"const": "NARROWER_SUCCESSOR_OF"},
              "claim_id": {"type": "string"},
              "scientific_supersession": {"const": false}
            }
          },
          "authority": {
            "type": "object",
            "properties": {
              "external_superiority_authorized": {"type": "boolean"},
              "naturalistic_evidence": {"type": "boolean"},
              "publication_novelty_authorized": {"type": "boolean"}
            }
          }
        }
      }
    },
    "scientific_result_verification": {
      "type": "object",
      "required": ["owner_issue", "schema_name", "records_present"],
      "properties": {
        "owner_issue": {"const": 283},
        "schema_name": {"const": "ScientificResultVerification.v1"},
        "records_present": {"type": "array"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"package_status": {"const": "SUPERSEDED"}},
        "required": ["package_status"]
      },
      "then": {
        "required": ["package_authority"],
        "properties": {
          "package_authority": {
            "required": ["current_submission_authorized"],
            "properties": {
              "current_submission_authorized": {"const": false}
            }
          },
          "claims": {
            "contains": {
              "type": "object",
              "required": ["status", "current_claim"],
              "properties": {
                "status": {"const": "OPEN"},
                "current_claim": {"const": true}
              }
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
