{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion.publication-run-manifest.v1",
  "title": "ORION Publication Run Manifest V1",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "protocol_id",
    "protocol_digest",
    "subject_revision",
    "data_artifacts",
    "model_provider_revisions",
    "baseline_config_hashes",
    "evaluator_hash",
    "split_hashes",
    "evaluation_epoch",
    "seeds",
    "resource_limits",
    "environment",
    "access_policy_hash",
    "artifact_root",
    "created_before_outcome_access"
  ],
  "properties": {
    "schema_version": {"const": "orion.publication-run-manifest.v1"},
    "paper_id": {"enum": ["P1", "P2", "P3", "P4", "P5"]},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "data_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "revision_or_hash", "access"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "revision_or_hash": {"type": "string", "minLength": 1},
          "access": {"enum": ["PUBLIC", "LICENSED", "PROTECTED", "LOCAL_FROZEN"]},
          "license": {"type": ["string", "null"]},
          "retrieval_timestamp": {"type": ["string", "null"]}
        }
      }
    },
    "model_provider_revisions": {"type": "object", "minProperties": 1},
    "baseline_config_hashes": {"type": "object", "minProperties": 1},
    "evaluator_hash": {"type": "string", "minLength": 1},
    "split_hashes": {"type": "object", "minProperties": 1},
    "evaluation_epoch": {"type": "string", "minLength": 1},
    "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "resource_limits": {"type": "object", "minProperties": 1},
    "environment": {
      "type": "object",
      "required": ["python", "dependencies_hash", "runner", "hardware"],
      "properties": {
        "python": {"type": "string"},
        "dependencies_hash": {"type": "string"},
        "runner": {"type": "string"},
        "hardware": {"type": "string"},
        "container_or_image": {"type": ["string", "null"]}
      }
    },
    "access_policy_hash": {"type": "string", "minLength": 1},
    "artifact_root": {"type": "string", "minLength": 1},
    "created_before_outcome_access": {"const": true},
    "notes": {"type": "string"}
  }
}
