{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion.publication-protocol.v1",
  "title": "ORION Publication Protocol V1",
  "type": "object",
  "required": [
    "schema_version", "paper_id", "protocol_id", "protocol_status", "outcome_accessed",
    "primary_hypothesis", "task_families", "baselines", "ablations", "metrics",
    "resource_policy", "exclusion_policy", "statistics", "access_policy", "plots", "tables",
    "execution_bindings"
  ],
  "properties": {
    "schema_version": {"const": "orion.publication-protocol.v1"},
    "paper_id": {"enum": ["P1", "P2", "P3", "P4", "P5"]},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_status": {"enum": ["DESIGN_FROZEN", "EXECUTION_FROZEN", "OUTCOME_ACCESSED", "INVALIDATED"]},
    "outcome_accessed": {"type": "boolean"},
    "primary_hypothesis": {
      "type": "object",
      "required": ["id", "text", "primary_metric", "direction"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "primary_metric": {"type": "string"},
        "direction": {"enum": ["higher", "lower", "superiority_and_safety", "descriptive"]}
      }
    },
    "secondary_hypotheses": {"type": "array", "items": {"type": "object"}},
    "task_families": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "baselines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ablations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metrics": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "secondary": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resource_policy": {"type": "string", "minLength": 1},
    "exclusion_policy": {"type": "string", "minLength": 1},
    "statistics": {
      "type": "object",
      "required": ["unit", "interval", "stochastic_repeats", "multiplicity", "practical_margin"]
    },
    "access_policy": {
      "type": "object",
      "required": ["hidden_labels", "evaluator_custody", "search_contamination_policy", "access_logging"]
    },
    "plots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "execution_bindings": {
      "type": "object",
      "required": ["subject_revision", "dataset_revisions", "model_provider_revisions", "baseline_config_hashes", "evaluator_hash", "split_hashes", "evaluation_epoch"]
    }
  }
}
