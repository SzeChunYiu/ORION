      "probe_id": "case_id_shape"
    },
    {
      "cue_names": [
        "case_family"
      ],
      "cue_rationale": "the closed-vocabulary token naming which contrast dimension the case was drawn to probe, read as an opaque token; it names the axis, and a family that determined the answer would be a construction cue by definition",
      "kind": "ENUM_VALUE",
      "probe_id": "case_family"
    },
    {
      "cue_names": [
        "discipline"
      ],
      "cue_rationale": "the closed-vocabulary discipline stratum the case was sampled into; which field a pair comes from carries none of the comparison",
