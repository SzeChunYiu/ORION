{
  "$id": "ORION.scientific-transfer-object.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "problem_signature",
    "io_contract",
    "obligations",
    "assumptions",
    "preconditions",
    "transformation_steps",
    "failure_modes",
    "verification_hooks",
    "falsifiers",
    "authority_boundaries",
    "cost_requirements",
    "evidence_level",
    "source_evidence_identities",
    "target_compatibility_tests",
    "forbidden_transfers",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "ORION_SCIENTIFIC_TRANSFER_OBJECT_V1"},
    "object_id": {"minLength": 1, "type": "string"},
    "problem_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_id",
        "family_id",
        "surface_domain",
        "hidden_state",
        "observability",
        "actions",
        "ground_truth_class",
        "dependence",
        "authority_risk",
        "nonstationarity",
        "reversibility"
      ],
      "properties": {
        "signature_id": {"minLength": 1, "type": "string"},
        "family_id": {
          "enum": [
            "debugging",
            "retrieval_stopping",
            "semantic_mapping",
            "protected_verification"
          ]
        },
        "surface_domain": {"minLength": 1, "type": "string"},
        "hidden_state": {"minLength": 1, "type": "string"},
        "observability": {"minLength": 1, "type": "string"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "ground_truth_class": {"type": "string"},
        "dependence": {"type": "number", "minimum": 0, "maximum": 1},
        "authority_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "nonstationarity": {"type": "number", "minimum": 0, "maximum": 1},
        "reversibility": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "io_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "observables"],
      "properties": {
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "observables": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "preconditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "transformation_steps": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "verification_hooks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "falsifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_grant", "may_not_grant"],
      "properties": {
        "may_grant": {"type": "array", "items": {"type": "string"}},
        "may_not_grant": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "cost_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_budget", "tools_required"],
      "properties": {
        "context_budget": {"type": "integer", "minimum": 0},
        "tools_required": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_level": {"const": "LOCAL_ENGINEERING_ONLY"},
    "source_evidence_identities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_compatibility_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_transfers": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
