tents/cpp%2FPAIpp.exe?ref=6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5"},{"sha":"fe3a3eec420e2d736e2d3150a553f86787ccd755","filename":"cpp/README.md","status":"modified","additions":31,"deletions":5,"changes":36,"blob_url":"https://github.com/NutritionalLungImmunity/PAI/blob/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/cpp%2FREADME.md","raw_url":"https://github.com/NutritionalLungImmunity/PAI/raw/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/cpp%2FREADME.md","contents_url":"https://api.github.com/repos/NutritionalLungImmunity/PAI/contents/cpp%2FREADME.md?ref=6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5","patch":"@@ -9,12 +9,16 @@ See [INSTALL.md](INSTALL.md) for platform-specific instructions.\n ### Quick Start (Unix/macOS/Linux)\n \n ```bash\n-git clone https://github.com/...\n-cd PAI++\n+git clone https://github.com/NutritionalLungImmunity/PAI.git\n+cd PAI/cpp\n cmake -S . -B build\n cmake --build build\n ./build/PAIpp <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n+Example\n+```bash\n+./build/PAIpp 15 1920 15 640\n+```\n \n ### macOS\n \n@@ -33,12 +37,16 @@ cmake -S . -B build\n cmake --build build\n ./build/PAIpp <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n+Example\n+```bash\n+./build/PAIpp 15 1920 15 640\n+```\n \n ### Windows (MinGW)\n \n #### Requirements\n \n-- MinGW-w64\n+- MinGW\n - Add mingw32-make to PATH\n - CMake\n \n@@ -49,6 +57,10 @@ cmake -G \"MinGW Makefiles\" -S . -B build\n cmake --build build\n ./build/PAIpp.exe <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n+Example\n+```bash\n+./build/PAIpp.exe 15 1920 15 640\n+```\n \n From Command prompt or PowerShell:\n \n@@ -57,7 +69,10 @@ cmake -G \"MinGW Makefiles\" -S . -B build\n cmake --build build\n .\\build\\PAIpp.exe <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n-\n+Example\n+```batch\n+.\\build\\PAIpp.exe 15 1920 15 640\n+```\n ### Windows (Cygwin)\n \n #### Requirements\n@@ -73,6 +88,10 @@ cmake -G \"Unix Makefiles\" -S . -B build\n cmake --build build\n ./build/PAIpp.exe <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n+Example\n+```bash\n+./build/PAIpp.exe 15 1920 15 640\n+```\n \n From Command prompt or PowerShell:\n \n@@ -81,7 +100,10 @@ cmake -G \"Unix Makefiles\" -S . -B build\n cmake --build build\n .\\build\\PAIpp.exe <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n-\n+Example\n+```batch\n+.\\build\\PAIpp.exe 15 1920 15 640\n+```\n ### Linux/Unix/\n \n #### Requirements\n@@ -101,6 +123,10 @@ cmake -S . -B build\n cmake --build build\n ./build/PAIpp <num_neutrophils> <num_aspergillus> <num_macrophages> <num_pneumocytes>\n ```\n+Example\n+```bash\n+./build/PAIpp 15 1920 15 640\n+```\n \n ## Clean build\n "},{"sha":"6ff819b0757d8887ddc5eef37b994024cb7b4b74","filename":"cpp/test_paipp.py","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/NutritionalLungImmunity/PAI/blob/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/cpp%2Ftest_paipp.py","raw_url":"https://github.com/NutritionalLungImmunity/PAI/raw/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/cpp%2Ftest_paipp.py","contents_url":"https://api.github.com/repos/NutritionalLungImmunity/PAI/contents/cpp%2Ftest_paipp.py?ref=6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5","patch":"@@ -80,6 +80,8 @@ def test(f, ref_afumigatus, ref_tnf, ref_ma, ref_afumigatus_std, ref_tnf_std, re\n \n pass_all_tests = True\n \n+print(\"Test is starting\")\n+\n if platform.system() == \"Windows\":\n     app_name = \"./PAIpp.exe\"\n else:"},{"sha":"f66ba0e4e39d423a24cb43fb61505e227fab68d8","filename":"java/README.md","status":"modified","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/NutritionalLungImmunity/PAI/blob/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/java%2FREADME.md","raw_url":"https://github.com/NutritionalLungImmunity/PAI/raw/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/java%2FREADME.md","contents_url":"https://api.github.com/repos/NutritionalLungImmunity/PAI/contents/java%2FREADME.md?ref=6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5","patch":"@@ -1,6 +1,8 @@\n # jPAI\n java Pulmonary Agent-based Infection simulator\n \n+This is a java cross-platform project build with javac. Buidable on Windows, Linux, and macOS via terminal.\n+\n - Java Runtime Environment (JRE) 8 or later  \n   (Tested with Java 18.0.2)\n \n@@ -15,6 +17,28 @@ Example\n java -jar jPAI.jar 15 1920 15 640\n ```\n \n+## Build Instructions\n+\n+- java 1.8\n+- javac 1.8\n+\n+### Unix/macOS/Linux\n+\n+```bash\n+git clone https://github.com/NutritionalLungImmunity/PAI.git\n+cd PAI/java\n+javac -d bin $(find . -name \"*.java\")\n+jar cfe jPAI.jar edu.uf.main.Main -C bin .\n+```\n+\n+### Windows\n+\n+Command Prompt or PowerShell\n+\n+```batch\n+javac -d bin $(Get-ChildItem -Path . -Filter *.java -Recurse | ForEach-Object { $_.FullName })\n+jar cfe jPAI.jar edu.uf.main.Main -C bin .\n+```\n \n ## Test\n "},{"sha":"75f55410538fa275b1f51b8dfe8cbc195a24a27c","filename":"java/test_jpai.py","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/NutritionalLungImmunity/PAI/blob/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/java%2Ftest_jpai.py","raw_url":"https://github.com/NutritionalLungImmunity/PAI/raw/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/java%2Ftest_jpai.py","contents_url":"https://api.github.com/repos/NutritionalLungImmunity/PAI/contents/java%2Ftest_jpai.py?ref=6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5","patch":"@@ -78,6 +78,8 @@ def test(f, ref_afumigatus, ref_tnf, ref_ma, ref_afumigatus_std, ref_tnf_std, re\n \n pass_all_tests = True\n \n+print(\"Test is starting\")\n+\n with open(\"file.tsv\", \"w\") as outfile:\n     result=subprocess.run(\n         [\"java\", \"-jar\", \"jPAI.jar\", \"15\", \"1920\", \"15\", \"640\"],"},{"sha":"11aa0299f89abd31a430dcc41a33df903ab018bf","filename":"run.sh","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/NutritionalLungImmunity/PAI/blob/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/run.sh","raw_url":"https://github.com/NutritionalLungImmunity/PAI/raw/6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5/run.sh","contents_url":"https://api.github.com/repos/NutritionalLungImmunity/PAI/contents/run.sh?ref=6e7f7b5c8e4502cb3e6f6ee20d30b72ebbe697f5","patch":"@@ -0,0 +1,22 @@\n+#!/bin/bash\n+\n+MODE=\"$1\"\n+shift\n+\n+case \"$MODE\" in \n+    cpp)\n+        exec ./cpp/build/PAIpp \"$@\"\n+        ;;\n+    java)\n+        exec java -jar jPAI.jar \"$@\"\n+        ;;\n+    ctest)\n+        exec python3 cpp/test_paipp.py\n+        ;;\n+    jtest)\n+        exec python3 java/test_jpai.py\n+        ;;\n+    *)\n+        echo \"Usage: cpp|java|ctest|jtest\"\n+        exit 1\n+esac\n\\ No newline at end of file"}]}