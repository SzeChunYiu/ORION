{"sha":"a85df681d29a5cf3406d529144a7c0645e543e61","node_id":"C_kwDOSaZ1cdoAKGE4NWRmNjgxZDI5YTVjZjM0MDZkNTI5MTQ0YTdjMDY0NWU1NDNlNjE","commit":{"author":{"name":"Olivier Labayle","email":"olabayle@gmail.com","date":"2026-05-11T14:20:36Z"},"committer":{"name":"Olivier Labayle","email":"olabayle@gmail.com","date":"2026-05-11T14:20:36Z"},"message":"reupload","tree":{"sha":"178315b57afafc1f20ab9929b4de893430524c62","url":"https://api.github.com/repos/TARGENE/targene-pipeline/git/trees/178315b57afafc1f20ab9929b4de893430524c62"},"url":"https://api.github.com/repos/TARGENE/targene-pipeline/git/commits/a85df681d29a5cf3406d529144a7c0645e543e61","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/TARGENE/targene-pipeline/commits/a85df681d29a5cf3406d529144a7c0645e543e61","html_url":"https://github.com/TARGENE/targene-pipeline/commit/a85df681d29a5cf3406d529144a7c0645e543e61","comments_url":"https://api.github.com/repos/TARGENE/targene-pipeline/commits/a85df681d29a5cf3406d529144a7c0645e543e61/comments","author":{"login":"olivierlabayle","id":48188914,"node_id":"MDQ6VXNlcjQ4MTg4OTE0","avatar_url":"https://avatars.githubusercontent.com/u/48188914?v=4","gravatar_id":"","url":"https://api.github.com/users/olivierlabayle","html_url":"https://github.com/olivierlabayle","followers_url":"https://api.github.com/users/olivierlabayle/followers","following_url":"https://api.github.com/users/olivierlabayle/following{/other_user}","gists_url":"https://api.github.com/users/olivierlabayle/gists{/gist_id}","starred_url":"https://api.github.com/users/olivierlabayle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olivierlabayle/subscriptions","organizations_url":"https://api.github.com/users/olivierlabayle/orgs","repos_url":"https://api.github.com/users/olivierlabayle/repos","events_url":"https://api.github.com/users/olivierlabayle/events{/privacy}","received_events_url":"https://api.github.com/users/olivierlabayle/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"olivierlabayle","id":48188914,"node_id":"MDQ6VXNlcjQ4MTg4OTE0","avatar_url":"https://avatars.githubusercontent.com/u/48188914?v=4","gravatar_id":"","url":"https://api.github.com/users/olivierlabayle","html_url":"https://github.com/olivierlabayle","followers_url":"https://api.github.com/users/olivierlabayle/followers","following_url":"https://api.github.com/users/olivierlabayle/following{/other_user}","gists_url":"https://api.github.com/users/olivierlabayle/gists{/gist_id}","starred_url":"https://api.github.com/users/olivierlabayle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olivierlabayle/subscriptions","organizations_url":"https://api.github.com/users/olivierlabayle/orgs","repos_url":"https://api.github.com/users/olivierlabayle/repos","events_url":"https://api.github.com/users/olivierlabayle/events{/privacy}","received_events_url":"https://api.github.com/users/olivierlabayle/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[],"stats":{"total":67405,"additions":67405,"deletions":0},"files":[{"sha":"c9f9d72f77d253ee80a8ee7b65ef5279d53213ac","filename":".github/workflows/CI.yml","status":"added","additions":75,"deletions":0,"changes":75,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/.github%2Fworkflows%2FCI.yml","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/.github%2Fworkflows%2FCI.yml","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/.github%2Fworkflows%2FCI.yml?ref=a85df681d29a5cf3406d529144a7c0645e543e61","patch":"@@ -0,0 +1,75 @@\n+name: CI\n+on:\n+  - push\n+  - pull_request\n+concurrency:\n+  # Skip intermediate builds: always.\n+  # Cancel intermediate builds: only if it is a pull request build.\n+  group: ${{ github.workflow }}-${{ github.ref }}\n+  cancel-in-progress: ${{ startsWith(github.ref, 'refs/pull/') }}\n+jobs:\n+  test:\n+    name: Test ${{ matrix.testrun }} -- ${{ github.event_name }}\n+    runs-on: ubuntu-latest\n+    strategy:\n+      fail-fast: false\n+      matrix:\n+        testrun:\n+          - \"ukb_gwas.jl\"\n+          - \"ukb_estimands_file.jl\"\n+          - \"custom_cohort_flat_config.jl\"\n+          - \"ukb_interactions_group_config.jl\"\n+          - \"empty_qq.jl\"\n+          - \"make_dataset.jl\"\n+          - \"null_simulation.jl\"\n+          - \"realistic_simulation.jl\"\n+    steps:\n+      - uses: actions/checkout@v4\n+      - name: Delete huge unnecessary tools folder\n+        run: |\n+          sudo rm -rf /opt/hostedtoolcache\n+          sudo rm -rf /usr/local/share/boost\n+          sudo rm -rf \"$AGENT_TOOLSDIRECTORY\"\n+          sudo rm -rf /usr/local/lib/android\n+          sudo rm -rf /usr/share/dotnet\n+          docker system prune -af\n+      - uses: julia-actions/setup-julia@v2\n+        with:\n+          version: 1.11\n+      - uses: actions/cache@v4\n+        env:\n+          cache-name: cache-artifacts\n+        with:\n+          path: ~/.julia/artifacts\n+          key: ${{ runner.os }}-test-${{ env.cache-name }}-${{ hashFiles('**/Project.toml') }}\n+          restore-keys: |\n+            ${{ runner.os }}-test-${{ env.cache-name }}-\n+            ${{ runner.os }}-test-\n+            ${{ runner.os }}-\n+      - uses: julia-actions/julia-buildpkg@v1\n+      - uses: nf-core/setup-nextflow@v1.2.0\n+      - name: Instantiate test environment\n+        run: julia --project=test --startup-file=no -e'using Pkg;Pkg.instantiate()'\n+      - name: Run tests\n+        run: julia --project=test --startup-file=no test/${{ matrix.testrun }} -profile ci -resume\n+  docs:\n+    name: Documentation\n+    permissions:\n+      actions: write\n+      contents: write\n+      pull-requests: read\n+      statuses: write\n+    runs-on: ubuntu-latest\n+    steps:\n+      - uses: actions/checkout@v4\n+      - uses: julia-actions/setup-julia@v2\n+        with:\n+          version: '1'\n+      - uses: julia-actions/cache@v2\n+      - name: Install dependencies\n+        run: julia --project=docs/ -e 'using Pkg; Pkg.instantiate()'\n+      - name: Build and deploy\n+        env:\n+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n+          DOCUMENTER_KEY: ${{ secrets.DOCUMENTER_KEY }}\n+        run: julia --project=docs/ docs/make.jl"},{"sha":"9b07ba09157ddc1fa153514470b3d3360a4785c2","filename":".gitignore","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/.gitignore","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/.gitignore","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/.gitignore?ref=a85df681d29a5cf3406d529144a7c0645e543e61","patch":"@@ -0,0 +1,20 @@\n+*.jl.*.cov\n+*.jl.cov\n+*.jl.mem\n+/docs/build/\n+.nextflow*\n+work/\n+results/\n+test.nf\n+publish_dir\n+test/grmmatrix\n+LocalPreferences.toml\n+test/sandbox.jl\n+docs/Manifest.toml\n+*.DS_Store\n+trace.txt*\n+trace.txt\n+trace*txt\n+simulation/\n+null_simulation/\n+causal_gap_test/"},{"sha":"6940430ded3871f511d6210f6a0718430562566d","filename":".vscode/ltex.dictionary.en-US.txt","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/.vscode%2Fltex.dictionary.en-US.txt","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/.vscode%2Fltex.dictionary.en-US.txt","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/.vscode%2Fltex.dictionary.en-US.txt?ref=a85df681d29a5cf3406d529144a7c0645e543e61","patch":"@@ -0,0 +1,2 @@\n+TarGene\n+estimands"},{"sha":"a4ec59fa7f71ba31526ab7dd1504431d7a32e009","filename":"CITATION.cff","status":"added","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/CITATION.cff","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/CITATION.cff","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/CITATION.cff?ref=a85df681d29a5cf3406d529144a7c0645e543e61","patch":"@@ -0,0 +1,44 @@\n+cff-version: 1.2.0\n+message: \"If you use this software, please cite it as below.\"\n+title: 'TarGene: A Nextflow pipeline for the estimation of genetic effects on human traits via semi-parametric methods.'\n+tags:\n+  - nextflow\n+  - statistics\n+  - semi-parametric statistics\n+  - population genetics\n+  - genetic effects\n+  - causal inference\n+authors:\n+  - name: Olivier Labayle\n+    orcid: 0000-0002-3708-3706\n+    affiliation: \"1, 2\"\n+  - name: Joshua Slaughter\n+    affiliation: \"1, 2\"\n+    orcid: 0000-0002-1400-6599\n+  - name: Breeshey Roskams-Hieter\n+    affiliation: \"1, 2\"\n+    orcid: 0000-0002-1119-2576\n+  - name: Kelsey Tetley-Campbell\n+    affiliation: \"1, 2\"\n+  - name: Mark J. van der Laan\n+    orcid: 0000-0003-1432-5511\n+    affiliation: \"4\"\n+  - name: Chris P. Ponting\n+    affiliation: \"1\"\n+    orcid: 0000-0003-0202-7816\n+  - name: Ava Khamseh\n+    affiliation: \"1, 2, 4\"\n+    orcid: 0000-0001-5203-2205\n+  - name: Sjoerd Viktor Beentjes\n+    affiliation: \"1, 3, 4\"\n+    orcid: 0000-0002-7998-4262\n+affiliations:\n+  - name: MRC Human Genetics Unit, Institute of Genetics and Cancer, University of Edinburgh, Edinburgh EH4 2XU, United Kingdom.\n+    index: 1\n+  - name: School of Informatics, University of Edinburgh, Edinburgh EH8 9AB, United Kingdom\n+    index: 2\n+  - name: School of Mathematics and Maxwell Institute for Mathematical Sciences, University of Edinburgh, Edinburgh EH9 3FD, United Kingdom\n+    index: 3\n+  - name: Division of Biostatistics, University of California, Berkeley, CA, USA\n+    index: 4\n+url: \"https://github.com/TARGENE/targene-pipeline\""},{"sha":"a2bc6f7644e165ad7c9b0c6215ba20bdbe634728","filename":"LICENSE","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/LICENSE","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/LICENSE","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/LICENSE?ref=a85df681d29a5cf3406d529144a7c0645e543e61","patch":"@@ -0,0 +1,21 @@\n+MIT License\n+\n+Copyright (c) 2021 Olivier Labayle\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy\n+of this software and associated documentation files (the \"Software\"), to deal\n+in the Software without restriction, including without limitation the rights\n+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n+copies of the Software, and to permit persons to whom the Software is\n+furnished to do so, subject to the following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all\n+copies or substantial portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n+SOFTWARE."},{"sha":"c913b108ddd22be8a0fcfbd3fbfce41363374c26","filename":"README.md","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/README.md","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/README.md","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/README.md?ref=a85df681d29a5cf3406d529144a7c0645e543e61","patch":"@@ -0,0 +1,35 @@\n+# TarGene-Pipeline\n+\n+TarGene is a Nextflow pipeline for the estimation of genetic effects on human traits using highly flexible semi-parametric inference methods (Targeted Minimum Loss-Based Estimation, One-Step Estimation). \n+\n+## Is TarGene for you?\n+\n+If you would like to use flexible machine-learning methods while preserving valid statistical inference **and** your project falls within any of the following, then the answer is Yes!\n+\n+Supported study designs:\n+\n+- GWAS\n+- PheWAS\n+- Custom\n+\n+Supported databases:\n+\n+- UK Biobank\n+- All of Us\n+- Custom\n+\n+Supported genetic effects:\n+- Main effects\n+- Interactions up to any order\n+\n+## Documentation Access\n+\n+Want to know more? Please visit [the docs](https://targene.github.io/targene-pipeline/stable/).\n+\n+## Running the Workflow\n+\n+TarGene is a Nextflow pipeline, please refer to [their documentation](https://www.nextflow.io/) for general usage. The main point being that, depending on your HPC specifications, you will need to provide a specific `myplatform.config` configuration file on top of your project `myproject.config` configuration file.\n+\n+```bash\n+nextflow run TARGENE/targene-pipeline -c myplatform.config -c myproject.config -resume\n+```"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"assets/NO_EXTRA_CONFOUNDER","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_EXTRA_CONFOUNDER","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_EXTRA_CONFOUNDER","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/assets%2FNO_EXTRA_CONFOUNDER?ref=a85df681d29a5cf3406d529144a7c0645e543e61"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"assets/NO_EXTRA_COVARIATE","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_EXTRA_COVARIATE","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_EXTRA_COVARIATE","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/assets%2FNO_EXTRA_COVARIATE?ref=a85df681d29a5cf3406d529144a7c0645e543e61"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"assets/NO_EXTRA_TREATMENT","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_EXTRA_TREATMENT","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_EXTRA_TREATMENT","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/assets%2FNO_EXTRA_TREATMENT?ref=a85df681d29a5cf3406d529144a7c0645e543e61"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"assets/NO_LD_BLOCKS","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_LD_BLOCKS","raw_url":"https://github.com/TARGENE/targene-pipeline/raw/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2FNO_LD_BLOCKS","contents_url":"https://api.github.com/repos/TARGENE/targene-pipeline/contents/assets%2FNO_LD_BLOCKS?ref=a85df681d29a5cf3406d529144a7c0645e543e61"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"assets/NO_QC_FILE","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/TARGENE/targene-pipeline/blob/a85df681d29a5cf3406d529144a7c0645e543e61/assets%2