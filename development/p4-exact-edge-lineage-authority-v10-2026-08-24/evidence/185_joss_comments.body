-reviews/issues/9364","id":4013337605,"node_id":"IC_kwDOAx6EUs7vNqwF","user":{"login":"editorialbot","id":89919391,"node_id":"MDQ6VXNlcjg5OTE5Mzkx","avatar_url":"https://avatars.githubusercontent.com/u/89919391?v=4","gravatar_id":"","url":"https://api.github.com/users/editorialbot","html_url":"https://github.com/editorialbot","followers_url":"https://api.github.com/users/editorialbot/followers","following_url":"https://api.github.com/users/editorialbot/following{/other_user}","gists_url":"https://api.github.com/users/editorialbot/gists{/gist_id}","starred_url":"https://api.github.com/users/editorialbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/editorialbot/subscriptions","organizations_url":"https://api.github.com/users/editorialbot/orgs","repos_url":"https://api.github.com/users/editorialbot/repos","events_url":"https://api.github.com/users/editorialbot/events{/privacy}","received_events_url":"https://api.github.com/users/editorialbot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T18:33:05Z","updated_at":"2026-03-06T18:33:05Z","body":":point_right::page_facing_up: [Download article proof](https://raw.githubusercontent.com/openjournals/joss-papers/joss.09364/joss.09364/10.21105.joss.09364.pdf) :page_facing_up: [View article proof on GitHub](https://github.com/openjournals/joss-papers/blob/joss.09364/joss.09364/10.21105.joss.09364.pdf) :page_facing_up: :point_left:","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4013337605/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4013845298","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4013845298","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4013845298,"node_id":"IC_kwDOAx6EUs7vPmsy","user":{"login":"rmrsk","id":39047996,"node_id":"MDQ6VXNlcjM5MDQ3OTk2","avatar_url":"https://avatars.githubusercontent.com/u/39047996?v=4","gravatar_id":"","url":"https://api.github.com/users/rmrsk","html_url":"https://github.com/rmrsk","followers_url":"https://api.github.com/users/rmrsk/followers","following_url":"https://api.github.com/users/rmrsk/following{/other_user}","gists_url":"https://api.github.com/users/rmrsk/gists{/gist_id}","starred_url":"https://api.github.com/users/rmrsk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rmrsk/subscriptions","organizations_url":"https://api.github.com/users/rmrsk/orgs","repos_url":"https://api.github.com/users/rmrsk/repos","events_url":"https://api.github.com/users/rmrsk/events{/privacy}","received_events_url":"https://api.github.com/users/rmrsk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-06T20:01:11Z","updated_at":"2026-03-06T20:01:11Z","body":"@jatkinson1000 @gtrevisan Just read the paper and it looks good to me.\n\nJust finished my checklist. Tag me if anything else comes up!\n\nCongrats @gtrevisan and coworkers :)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4013845298/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4023472827","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4023472827","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4023472827,"node_id":"IC_kwDOAx6EUs7v0VK7","user":{"login":"LiamPattinson","id":14332134,"node_id":"MDQ6VXNlcjE0MzMyMTM0","avatar_url":"https://avatars.githubusercontent.com/u/14332134?v=4","gravatar_id":"","url":"https://api.github.com/users/LiamPattinson","html_url":"https://github.com/LiamPattinson","followers_url":"https://api.github.com/users/LiamPattinson/followers","following_url":"https://api.github.com/users/LiamPattinson/following{/other_user}","gists_url":"https://api.github.com/users/LiamPattinson/gists{/gist_id}","starred_url":"https://api.github.com/users/LiamPattinson/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LiamPattinson/subscriptions","organizations_url":"https://api.github.com/users/LiamPattinson/orgs","repos_url":"https://api.github.com/users/LiamPattinson/repos","events_url":"https://api.github.com/users/LiamPattinson/events{/privacy}","received_events_url":"https://api.github.com/users/LiamPattinson/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-09T12:40:11Z","updated_at":"2026-03-09T12:40:11Z","body":"I've just read the new draft of the paper, and it's all looking solid to me, so that's also my checklist finished.\n\nThanks to @gtrevisan for responding to all of our feedback, and to @jatkinson1000 and @rmrsk for your work on the review!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4023472827/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4033351859","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4033351859","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4033351859,"node_id":"IC_kwDOAx6EUs7waBCz","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-10T17:53:10Z","updated_at":"2026-03-10T17:53:10Z","body":"what's next, @jatkinson1000? \n\nthe last action by @jackleland is an edit on his checklist from Dec 5th, over two months ago...","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4033351859/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4033444511","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4033444511","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4033444511,"node_id":"IC_kwDOAx6EUs7waXqf","user":{"login":"jackleland","id":25505076,"node_id":"MDQ6VXNlcjI1NTA1MDc2","avatar_url":"https://avatars.githubusercontent.com/u/25505076?v=4","gravatar_id":"","url":"https://api.github.com/users/jackleland","html_url":"https://github.com/jackleland","followers_url":"https://api.github.com/users/jackleland/followers","following_url":"https://api.github.com/users/jackleland/following{/other_user}","gists_url":"https://api.github.com/users/jackleland/gists{/gist_id}","starred_url":"https://api.github.com/users/jackleland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jackleland/subscriptions","organizations_url":"https://api.github.com/users/jackleland/orgs","repos_url":"https://api.github.com/users/jackleland/repos","events_url":"https://api.github.com/users/jackleland/events{/privacy}","received_events_url":"https://api.github.com/users/jackleland/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-10T18:09:34Z","updated_at":"2026-03-10T18:09:34Z","body":"Hi all, sorry not sure how this slipped off my radar - happy to finish my review if necessary @jatkinson1000 ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4033444511/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4039170236","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4039170236","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4039170236,"node_id":"IC_kwDOAx6EUs7wwNi8","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T13:20:43Z","updated_at":"2026-03-11T13:20:43Z","body":"@jackleland in order to speed things up, why don't you complete your review in the next few days? hopefully it's going to be smooth! 🚀 \n\n@jatkinson1000 I've noticed that the guidelines mention \"two or more\" reviewers, so maybe two will suffice? please let us know whether the third review is necessary.\n\nthank you all!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4039170236/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4039246561","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4039246561","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4039246561,"node_id":"IC_kwDOAx6EUs7wwgLh","user":{"login":"jatkinson1000","id":109271713,"node_id":"U_kgDOBoNaoQ","avatar_url":"https://avatars.githubusercontent.com/u/109271713?v=4","gravatar_id":"","url":"https://api.github.com/users/jatkinson1000","html_url":"https://github.com/jatkinson1000","followers_url":"https://api.github.com/users/jatkinson1000/followers","following_url":"https://api.github.com/users/jatkinson1000/following{/other_user}","gists_url":"https://api.github.com/users/jatkinson1000/gists{/gist_id}","starred_url":"https://api.github.com/users/jatkinson1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jatkinson1000/subscriptions","organizations_url":"https://api.github.com/users/jatkinson1000/orgs","repos_url":"https://api.github.com/users/jatkinson1000/repos","events_url":"https://api.github.com/users/jatkinson1000/events{/privacy}","received_events_url":"https://api.github.com/users/jatkinson1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T13:32:37Z","updated_at":"2026-03-11T13:32:37Z","body":"Hi @jackleland and @gtrevisan \n\nJOSS requires 2 reviews to pass, so at this point you do not need to complete a review unless you want to @jackleland \n3 reviews is preferred - as more comprehensive and in case people disappear mid-review - but not required.\n\nPlease let me know how you wish to proceed.\n\n@gtrevisan I will work through this on Friday when I have time set aside for detailed JOSS work (editing is also voluntary and I cannot do everything as soon as they become available from authors/reviewers). However, you may wish to read through the post-review steps for authors (creating a release and archive etc.) to ensure that you are ready to do this when required.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4039246561/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4039325714","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4039325714","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4039325714,"node_id":"IC_kwDOAx6EUs7wwzgS","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T13:44:32Z","updated_at":"2026-03-11T14:24:02Z","body":"@jackleland any further review is welcome, but please let me know your intentions that so I can hold off any post-review action.\n\n@jatkinson1000 I can easily publish a new release in the next couple of days, as usual.\n\na couple of questions, feel free to answer when you have some spare time:\n- may I assume that the DOI assigned to this review is final? `10.21105/joss.09364`\n- may I push some README changes about the (imminent) acceptance of the JOSS paper in the repo itself just before tagging the new release?\n- should I do anything at all about the `glt/joss` paper branch? should I rebase it off of the new `main` once I release the final version?\n- when providing the archive DOI, may I use the version-agnostic one, or should I point at the upcoming release?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4039325714/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4040069450","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4040069450","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4040069450,"node_id":"IC_kwDOAx6EUs7wzpFK","user":{"login":"jatkinson1000","id":109271713,"node_id":"U_kgDOBoNaoQ","avatar_url":"https://avatars.githubusercontent.com/u/109271713?v=4","gravatar_id":"","url":"https://api.github.com/users/jatkinson1000","html_url":"https://github.com/jatkinson1000","followers_url":"https://api.github.com/users/jatkinson1000/followers","following_url":"https://api.github.com/users/jatkinson1000/following{/other_user}","gists_url":"https://api.github.com/users/jatkinson1000/gists{/gist_id}","starred_url":"https://api.github.com/users/jatkinson1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jatkinson1000/subscriptions","organizations_url":"https://api.github.com/users/jatkinson1000/orgs","repos_url":"https://api.github.com/users/jatkinson1000/repos","events_url":"https://api.github.com/users/jatkinson1000/events{/privacy}","received_events_url":"https://api.github.com/users/jatkinson1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T15:32:41Z","updated_at":"2026-03-11T15:32:41Z","body":"> * may I assume that the DOI assigned to this review is final? `10.21105/joss.09364`\n\nI think it should be, but cannot guarantee for sure. General advice would be to wait before using, and make any addition of badges/references a follow-up commit post-publication\n\n> * may I push some README changes about the (imminent) acceptance of the JOSS paper in the repo itself just before tagging the new release?\n\nProvided they are not major or code changes that would be fine - we accept that sometimes there are additions to be made to README/CHANGELOGs etc. before a final release can be created and tagged for the codebase.\n\n> * should I do anything at all about the `glt/joss` paper branch? should I rebase it off of the new `main` once I release the final version?\n\nThis is somewhat up to you.\nSome authors want the paper to appear in the repository so merge it, others leave it in a branch.\nThe only thing to say is that if you do choose to merge it it will cause some confusion in the review thread and I'll need to update the \"branch with paper\", so let me know if you do this.\n\nTo clarify here - the reviewers have been reviewing the main branch available from PyPI, so this is what the release archive should reflect. If you wish to rebase the paper branch so that those changes also appear in the paper branch that is fine (and I would agree, sensible).\n\n> * when providing the archive DOI, may I use the version-agnostic one, or should I point at the upcoming release?\n\nThe archive for JOSS must be the specific version/release that was reviewed and passed by the reviewers including any additions they made/suggested to meet the review criteria.\nThe author list should match that on the paper.\nSee [here](https://joss.readthedocs.io/en/latest/editing.html#post-review) for more information.\n\nThe easiest way, if acceptable to you, is to link your repository to zenodo so that each release automatically creates a new archive that can be pointed to specifically, but is also tied to future releases (so somewhat \"version-agnostic\").\nIf using other approaches you may need to create a specific instance for the reviewed version of the code.\n\nNote that there may be a couple of minor alterations as part of the editorial/typing process.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4040069450/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4040728345","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4040728345","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4040728345,"node_id":"IC_kwDOAx6EUs7w2J8Z","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T17:06:01Z","updated_at":"2026-03-11T17:06:01Z","body":"**wrt the paper branch:**\nI do _not_ wish to merge `glt/joss`, but I can easily rebase it off of the upcoming new `main` so that the code within that branch is updated following what will be archived on Zenodo.\nstill, what happens to that branch after publication? may it be deleted at some point, since it will stay unmerged forever?\n\n**wrt the Zenodo DOI:**\nwhat I mean is this, taken from our current Zenodo release versioning:\n\n<img width=\"479\" height=\"525\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/35f114b0-1d43-4914-a72c-b180b21ab2f0\" />\n\nat the time of publication, the \"cite all versions\" DOI [10.5281/zenodo.13935223](https://doi.org/10.5281/zenodo.13935223) _will automatically redirect_ to v0.14, and it will keep redirecting there until I release v0.15.\nnormally I very much prefer the version-agnostic DOI, so that new users will be redirected to the updated and current version, even if they are visiting from a very old link -- sometimes people might miss the top banner that Zenodo puts in place for outdated versions.\nif required, of course, I will use for JOSS the version-specific DOI that will be assigned to me upon release.\n\n**wrt the third review:**\nI'm happy to expedite this towards acceptance and publication, given my Jul 2025 submission, but once again -- @jackleland please stop me and let me know if you would like to contribute your review!\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4040728345/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4040783381","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4040783381","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4040783381,"node_id":"IC_kwDOAx6EUs7w2XYV","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-11T17:15:15Z","updated_at":"2026-03-11T17:15:15Z","body":"(apologies for the double post.)\n\nout of clarity, I plan to merge v0.14:\n- https://github.com/MIT-PSFC/disruption-py/pull/517\n\nwhich includes a tiny documentation PR following the above discussions:\n- https://github.com/MIT-PSFC/disruption-py/pull/525\n\nbut which also includes a handful of bug fixes and one small feature improvement:\n- https://github.com/MIT-PSFC/disruption-py/pull/520\n\nalternatively, I could merge **only the tiny documentation PR as a patch release**, ie v0.13.1 -- please LMK in case this is preferred to minimize diffs between already-reviewed and to-be-archived code.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4040783381/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4045030129","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4045030129","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4045030129,"node_id":"IC_kwDOAx6EUs7xGkLx","user":{"login":"jackleland","id":25505076,"node_id":"MDQ6VXNlcjI1NTA1MDc2","avatar_url":"https://avatars.githubusercontent.com/u/25505076?v=4","gravatar_id":"","url":"https://api.github.com/users/jackleland","html_url":"https://github.com/jackleland","followers_url":"https://api.github.com/users/jackleland/followers","following_url":"https://api.github.com/users/jackleland/following{/other_user}","gists_url":"https://api.github.com/users/jackleland/gists{/gist_id}","starred_url":"https://api.github.com/users/jackleland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jackleland/subscriptions","organizations_url":"https://api.github.com/users/jackleland/orgs","repos_url":"https://api.github.com/users/jackleland/repos","events_url":"https://api.github.com/users/jackleland/events{/privacy}","received_events_url":"https://api.github.com/users/jackleland/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-12T08:53:31Z","updated_at":"2026-03-12T08:53:31Z","body":"Happy to add my two cents, sounds like @LiamPattinson and @rmrsk have already done a thorough job so should be quick. I'll finish my review by the end of tomorrow.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4045030129/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4057494557","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4057494557","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4057494557,"node_id":"IC_kwDOAx6EUs7x2HQd","user":{"login":"jatkinson1000","id":109271713,"node_id":"U_kgDOBoNaoQ","avatar_url":"https://avatars.githubusercontent.com/u/109271713?v=4","gravatar_id":"","url":"https://api.github.com/users/jatkinson1000","html_url":"https://github.com/jatkinson1000","followers_url":"https://api.github.com/users/jatkinson1000/followers","following_url":"https://api.github.com/users/jatkinson1000/following{/other_user}","gists_url":"https://api.github.com/users/jatkinson1000/gists{/gist_id}","starred_url":"https://api.github.com/users/jatkinson1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jatkinson1000/subscriptions","organizations_url":"https://api.github.com/users/jatkinson1000/orgs","repos_url":"https://api.github.com/users/jatkinson1000/repos","events_url":"https://api.github.com/users/jatkinson1000/events{/privacy}","received_events_url":"https://api.github.com/users/jatkinson1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-13T19:31:59Z","updated_at":"2026-03-13T19:31:59Z","body":"Thanks @jackleland are you still on track to complete a review?\nI'd like to move this forward next week so if you could complete it by Monday that would be great.\n\nIf that's too soon let me know, we'll proceed with 2 reviewers and you can devote efforts towards a future JOSS paper!","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4057494557/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4057495373","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4057495373","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4057495373,"node_id":"IC_kwDOAx6EUs7x2HdN","user":{"login":"jatkinson1000","id":109271713,"node_id":"U_kgDOBoNaoQ","avatar_url":"https://avatars.githubusercontent.com/u/109271713?v=4","gravatar_id":"","url":"https://api.github.com/users/jatkinson1000","html_url":"https://github.com/jatkinson1000","followers_url":"https://api.github.com/users/jatkinson1000/followers","following_url":"https://api.github.com/users/jatkinson1000/following{/other_user}","gists_url":"https://api.github.com/users/jatkinson1000/gists{/gist_id}","starred_url":"https://api.github.com/users/jatkinson1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jatkinson1000/subscriptions","organizations_url":"https://api.github.com/users/jatkinson1000/orgs","repos_url":"https://api.github.com/users/jatkinson1000/repos","events_url":"https://api.github.com/users/jatkinson1000/events{/privacy}","received_events_url":"https://api.github.com/users/jatkinson1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-13T19:32:10Z","updated_at":"2026-03-13T19:32:10Z","body":"@editorialbot remind me in 3 days","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4057495373/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4057495506","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4057495506","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4057495506,"node_id":"IC_kwDOAx6EUs7x2HfS","user":{"login":"editorialbot","id":89919391,"node_id":"MDQ6VXNlcjg5OTE5Mzkx","avatar_url":"https://avatars.githubusercontent.com/u/89919391?v=4","gravatar_id":"","url":"https://api.github.com/users/editorialbot","html_url":"https://github.com/editorialbot","followers_url":"https://api.github.com/users/editorialbot/followers","following_url":"https://api.github.com/users/editorialbot/following{/other_user}","gists_url":"https://api.github.com/users/editorialbot/gists{/gist_id}","starred_url":"https://api.github.com/users/editorialbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/editorialbot/subscriptions","organizations_url":"https://api.github.com/users/editorialbot/orgs","repos_url":"https://api.github.com/users/editorialbot/repos","events_url":"https://api.github.com/users/editorialbot/events{/privacy}","received_events_url":"https://api.github.com/users/editorialbot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-13T19:32:12Z","updated_at":"2026-03-13T19:32:12Z","body":"Reminder set for @jatkinson1000 in 3 days","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4057495506/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4066915779","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4066915779","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4066915779,"node_id":"IC_kwDOAx6EUs7yaDXD","user":{"login":"jackleland","id":25505076,"node_id":"MDQ6VXNlcjI1NTA1MDc2","avatar_url":"https://avatars.githubusercontent.com/u/25505076?v=4","gravatar_id":"","url":"https://api.github.com/users/jackleland","html_url":"https://github.com/jackleland","followers_url":"https://api.github.com/users/jackleland/followers","following_url":"https://api.github.com/users/jackleland/following{/other_user}","gists_url":"https://api.github.com/users/jackleland/gists{/gist_id}","starred_url":"https://api.github.com/users/jackleland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jackleland/subscriptions","organizations_url":"https://api.github.com/users/jackleland/orgs","repos_url":"https://api.github.com/users/jackleland/repos","events_url":"https://api.github.com/users/jackleland/events{/privacy}","received_events_url":"https://api.github.com/users/jackleland/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-16T11:14:46Z","updated_at":"2026-03-16T11:14:46Z","body":"Okay, I've finished my review. Overall everything looks great and I was able to get the tests running on MAST data. I only have some very minor points:\n1. I spent a bit of time trying to install this and get it working on my Mac, but realised that MDSPlus doesn't support it. It doesn't actually say anywhere which OSs are supported so it might be worth explicitly mentioning that somewhere.\n2. Installing MDSPlus is a little more involved (I don't have access to a system with it on), so a dockerfile/devcontainer with dependencies pre-installed would make local testing and contributing easier. This could also be distributed as a singularity container if HPC is also the main usage scenario.\n3. There's not much info availble—bar 'make a PR'—if you want to contribute, so might be good to have a bit more detail in a CONTRIBUTING.md about how to get set up and what code standards to adhere to, though the extensive CI does get around the latter point. In addition to this, having a PULL_REQUEST_TEMPLATE.md would also standardise contributions. \n\nThat said I know I have got to this late so these are all pretty minor points, and should be viewed more as suggestions for future improvements than requirements for JOSS approval.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4066915779/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4067702909","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4067702909","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4067702909,"node_id":"IC_kwDOAx6EUs7ydDh9","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-16T13:33:23Z","updated_at":"2026-03-18T16:03:27Z","body":"@jackleland let me try and reply quickly here:\n\n1. MDSplus is a _pre-requisite_ for MDSplus machines, so I cannot spend time documenting its installation:\n\n    - MDSplus rarely needs to be _installed_ as MDSplus workflows should execute on the machines themselves, very close to the data, for obvious performance reasons;\n    - MDSplus has extensive support, including for older systems, but as for any client-server software infrastructure some care needs to be placed in making sure the client and server versions are compatible, which might be tricky if running a freshly-installed client version with some server which hasn't been updated since the 90s;\n    - MDSplus supports generic macOS machines but yes, AFAIK [compatibility issues are expected for Apple chips](https://www.mdsplus.org/index.php/Latest_Macintosh_Distributions);\n    - for cases like this I've included a python-only MDSplus driver, called `mdsthin`, in the `dev` dependency group, but I am not publicizing it as I don't think it's as robust as a full-fledged MDSplus installation -- in a sense, that solves any installation problem without the user being aware of it.\n\n2. due to the above reasons, I don't believe that containers would be a good investment right now:\n\n    - as mentioned, the proper way to satisfy the MDSplus prerequisite for MDSplus machines is using whatever is made available by IT on such systems;\n    - HPC systems are routinely used for hardcore computations, but are rarely deploying full-scale access to raw data capable of supporting truly HPC I/O operations -- with the only exception of the mentioned [TokSearch project](https://ga-fdp.github.io/toksearch/) which AFAIK has some serious hardware behind it _only_ on the DIII-D cluster;\n    - according to the systems I can access, so far containerization of HPC workflows has spotty support and even rarer adoption.\n\n3. that is something that I already evaluated, but decided that it's much better to wait and see what new contributions might pop up first, before thinking about standardizing them. due to the smallish scale of our project, I imagine any possible PR will be carefully reviewed separately in an iterative fashion, as we normally do. once I find myself asking the same questions in either issues or PRs, yes, I will definitely push a template to guide discussion from the start.\n\n@jatkinson1000 LMK if you agree that I may release v0.14.0 according to [my plan from a few messages above](https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4040783381)! thanks.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4067702909/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4069721159","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4069721159","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4069721159,"node_id":"IC_kwDOAx6EUs7ykwRH","user":{"login":"jatkinson1000","id":109271713,"node_id":"U_kgDOBoNaoQ","avatar_url":"https://avatars.githubusercontent.com/u/109271713?v=4","gravatar_id":"","url":"https://api.github.com/users/jatkinson1000","html_url":"https://github.com/jatkinson1000","followers_url":"https://api.github.com/users/jatkinson1000/followers","following_url":"https://api.github.com/users/jatkinson1000/following{/other_user}","gists_url":"https://api.github.com/users/jatkinson1000/gists{/gist_id}","starred_url":"https://api.github.com/users/jatkinson1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jatkinson1000/subscriptions","organizations_url":"https://api.github.com/users/jatkinson1000/orgs","repos_url":"https://api.github.com/users/jatkinson1000/repos","events_url":"https://api.github.com/users/jatkinson1000/events{/privacy}","received_events_url":"https://api.github.com/users/jatkinson1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-16T18:25:13Z","updated_at":"2026-03-16T18:25:13Z","body":"@gtrevisan and @jackleland \n\n**MDSplus**\nI think the suggestion of noting that there are issues with running the code and its dependencies on AppleSilicon is good. It is not unlikely that some users will have this operating system/hardware so noting up front that they should seek other resources to run it will help. E.g. it would have prevented @jackleland from trying to install it as described above. Whilst not publiscising `mdsthin` to generic users is fine, making it clear to MacOS AppliSilicon users that they can use the software with this would be useful. Perhaps an \"operating systems\" page can be added to the documentation, and/or a note to the README. Once this is done @jackleland can check to see that they are happy with this by following these instructions to get it to run on their machine.\n\n**Containers**\nContainers might be a nice solution to some workflows/issues, but I agree is not a requirement for publication here and now.\n\n**Contribution Guidelines**\nJOSS requires submissions to be freely open for contribution, and for there to be guidelines for users to do so. All three reviewers have checked off **Community guidelines** on the checklists, so this is not a barrier to publication.\nAs an advocate for Open-Source I would say that adding detailed guidelines can occur early in the project and always be changed/adapted later. It may make it easier for users to contribute. I reiterate that this is a personal note and not a blocker to publication.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4069721159/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4069875074","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4069875074","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4069875074,"node_id":"IC_kwDOAx6EUs7ylV2C","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-16T18:52:32Z","updated_at":"2026-03-16T18:52:32Z","body":"the way I see it, this is more like a project depending on CUDA not making it clear for users that a NVIDIA GPU is required... which could be true, but would probably be self-evident for most people.\nthen again, I've used a Macbook for years during my postdoc in Fusion, and of course I've met countless others, but I do not recall ever seeing anyone trying to install MDSplus, precisely because people just relied on the preinstalled server/cluster packages.\nin any case, I believe the new \"devices table\" clearly shows that the generic user will **_not_** require MDSplus -- only someone who is authorized to connect to MDSplus for some device will choose that route, and will probably be knowledgeable enough to simply skip any instruction presented in our repo.\n\nall the other points are duly noted, but at this time I am sure they will not prevent anybody from contributing!\n... complication of the subject matter might! 😄 \n\nunless further actions are required to complete the review, I would be happier to push this forward as soon as possible.\nLMK! thanks!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4069875074/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4070081953","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4070081953","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4070081953,"node_id":"IC_kwDOAx6EUs7ymIWh","user":{"login":"editorialbot","id":89919391,"node_id":"MDQ6VXNlcjg5OTE5Mzkx","avatar_url":"https://avatars.githubusercontent.com/u/89919391?v=4","gravatar_id":"","url":"https://api.github.com/users/editorialbot","html_url":"https://github.com/editorialbot","followers_url":"https://api.github.com/users/editorialbot/followers","following_url":"https://api.github.com/users/editorialbot/following{/other_user}","gists_url":"https://api.github.com/users/editorialbot/gists{/gist_id}","starred_url":"https://api.github.com/users/editorialbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/editorialbot/subscriptions","organizations_url":"https://api.github.com/users/editorialbot/orgs","repos_url":"https://api.github.com/users/editorialbot/repos","events_url":"https://api.github.com/users/editorialbot/events{/privacy}","received_events_url":"https://api.github.com/users/editorialbot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-16T19:32:13Z","updated_at":"2026-03-16T19:32:13Z","body":":wave: @jatkinson1000, please take a look at the state of the submission (this is an automated reminder).","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4070081953/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4081397226","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4081397226","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4081397226,"node_id":"IC_kwDOAx6EUs7zRS3q","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T10:31:25Z","updated_at":"2026-03-18T10:31:25Z","body":"@jatkinson1000 ?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4081397226/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4083555193","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4083555193","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4083555193,"node_id":"IC_kwDOAx6EUs7zZht5","user":{"login":"jatkinson1000","id":109271713,"node_id":"U_kgDOBoNaoQ","avatar_url":"https://avatars.githubusercontent.com/u/109271713?v=4","gravatar_id":"","url":"https://api.github.com/users/jatkinson1000","html_url":"https://github.com/jatkinson1000","followers_url":"https://api.github.com/users/jatkinson1000/followers","following_url":"https://api.github.com/users/jatkinson1000/following{/other_user}","gists_url":"https://api.github.com/users/jatkinson1000/gists{/gist_id}","starred_url":"https://api.github.com/users/jatkinson1000/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jatkinson1000/subscriptions","organizations_url":"https://api.github.com/users/jatkinson1000/orgs","repos_url":"https://api.github.com/users/jatkinson1000/repos","events_url":"https://api.github.com/users/jatkinson1000/events{/privacy}","received_events_url":"https://api.github.com/users/jatkinson1000/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T15:42:01Z","updated_at":"2026-03-18T15:42:01Z","body":"@gtrevisan CUDA is a widespread and well-known libraryand I agree when listed as a dependency users will usually know whether they are able to use software on their machine or not. I do not feel it is reasonable to compare knowledge of whether your machine supports CUDA to knowing whether your machine will support MDSPlus.\n\nFurther, libraries for which CUDA is optional will clearly outline alternative installation procedures for those without the ability to use CUDA on their system, e.g. PyTorch.\nYou have indicated that there is a workaround in the MDSPlus case by using `mdsthin`.\n\n@jackleland encountered an issue whilst attempting to evaluate the software according to its installation instructions and experienced difficulty. You responded to this to say that this is a known limitation, and that there is a workaround implemented.\nThe core of the JOSS review is to assess the usability of the software, that it does what it claims to, and make suggestions to improve the experience for other users.\nIt has been suggested that you add documentation to highlight known incompatibilities and possible workarounds so that future users do not encounter the same issues as @jackleland.\n\nI do not think this is a particularly strenuous or Herculean request.\nPlease make the changes and ask @jackleland for feedback as to whether they feel it resolves the difficulties they encountered. Once they are happy then we can proceed with wrapping this up.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4083555193/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4083811978","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4083811978","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4083811978,"node_id":"IC_kwDOAx6EUs7zagaK","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-18T16:18:08Z","updated_at":"2026-03-18T16:18:08Z","body":"@jackleland \nmay I ask why you felt the need to install MDSplus in the first place?\ndidn't the [Devices table](https://github.com/MIT-PSFC/disruption-py?tab=readme-ov-file#devices), wrt both the Data and Access columns, make it clear that for MAST -- which is the only open-access workflow available -- the MDSplus data access was not necessary?\n\nin any case, please LMK whether this is sufficient:\n- https://github.com/MIT-PSFC/disruption-py/pull/529\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4083811978/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4089216411","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4089216411","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4089216411,"node_id":"IC_kwDOAx6EUs7zvH2b","user":{"login":"jackleland","id":25505076,"node_id":"MDQ6VXNlcjI1NTA1MDc2","avatar_url":"https://avatars.githubusercontent.com/u/25505076?v=4","gravatar_id":"","url":"https://api.github.com/users/jackleland","html_url":"https://github.com/jackleland","followers_url":"https://api.github.com/users/jackleland/followers","following_url":"https://api.github.com/users/jackleland/following{/other_user}","gists_url":"https://api.github.com/users/jackleland/gists{/gist_id}","starred_url":"https://api.github.com/users/jackleland/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jackleland/subscriptions","organizations_url":"https://api.github.com/users/jackleland/orgs","repos_url":"https://api.github.com/users/jackleland/repos","events_url":"https://api.github.com/users/jackleland/events{/privacy}","received_events_url":"https://api.github.com/users/jackleland/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-19T10:40:32Z","updated_at":"2026-03-19T10:40:32Z","body":"A fair question, I was going off of information in INSTALL.md:\n\n> A private installation is possible on any machine, either on a personal laptop, or on any experimental cluster.\n\nAnd then further down\n\n> As Free/Libre and Open-Source Software (FLOSS), disruption-py can also be installed on any machine. We currently provide an installation guide for Ubuntu-based boxes, but generic Unix machines or Windows systems should support similar or equivalent steps.\n\nSo no I didn't need MDSPlus to use the open dataset in this case, but a user who did want to use one of the MDSPlus datasets from an apple silicon Mac would have encountered this problem. \n\nExtending the PR to include clarifications in INSTALL.md as well would be good.\n\n\n\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4089216411/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/4089547019","html_url":"https://github.com/openjournals/joss-reviews/issues/9364#issuecomment-4089547019","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9364","id":4089547019,"node_id":"IC_kwDOAx6EUs7zwYkL","user":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-19T11:41:52Z","updated_at":"2026-03-19T11:41:52Z","body":"@jackleland LMK if this works for you: [whole PR](https://github.com/MIT-PSFC/disruption-py/pull/529/changes) / [changes to INSTALL](https://github.com/MIT-PSFC/disruption-py/pull/529/commits/027734eea42d713755c8a5