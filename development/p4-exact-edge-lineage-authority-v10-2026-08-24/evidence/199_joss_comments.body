ss-reviews/issues/comments/3808919821","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3808919821","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3808919821,"node_id":"IC_kwDOAx6EUs7jB4EN","user":{"login":"ZeyuanSong","id":51000742,"node_id":"MDQ6VXNlcjUxMDAwNzQy","avatar_url":"https://avatars.githubusercontent.com/u/51000742?v=4","gravatar_id":"","url":"https://api.github.com/users/ZeyuanSong","html_url":"https://github.com/ZeyuanSong","followers_url":"https://api.github.com/users/ZeyuanSong/followers","following_url":"https://api.github.com/users/ZeyuanSong/following{/other_user}","gists_url":"https://api.github.com/users/ZeyuanSong/gists{/gist_id}","starred_url":"https://api.github.com/users/ZeyuanSong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ZeyuanSong/subscriptions","organizations_url":"https://api.github.com/users/ZeyuanSong/orgs","repos_url":"https://api.github.com/users/ZeyuanSong/repos","events_url":"https://api.github.com/users/ZeyuanSong/events{/privacy}","received_events_url":"https://api.github.com/users/ZeyuanSong/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-28T04:42:50Z","updated_at":"2026-01-28T04:42:50Z","body":"Thank you for the updates @olivierlabayle. I’m trying to replicate the GWAS example, but I’m encountering an error at the final step. I’ve attached the error log for reference. \n\n[MyJob.29732149.txt](https://github.com/user-attachments/files/24900000/MyJob.29732149.txt)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3808919821/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3811256782","html_url":"https://github.com/