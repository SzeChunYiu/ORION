9603/10.21105.joss.09603.pdf) :page_facing_up: :point_left:","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3636993067/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3642243328","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3642243328","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3642243328,"node_id":"IC_kwDOAx6EUs7ZGDkA","user":{"login":"kescobo","id":3502975,"node_id":"MDQ6VXNlcjM1MDI5NzU=","avatar_url":"https://avatars.githubusercontent.com/u/3502975?v=4","gravatar_id":"","url":"https://api.github.com/users/kescobo","html_url":"https://github.com/kescobo","followers_url":"https://api.github.com/users/kescobo/followers","following_url":"https://api.github.com/users/kescobo/following{/other_user}","gists_url":"https://api.github.com/users/kescobo/gists{/gist_id}","starred_url":"https://api.github.com/users/kescobo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kescobo/subscriptions","organizations_url":"https://api.github.com/users/kescobo/orgs","repos_url":"https://api.github.com/users/kescobo/repos","events_url":"https://api.github.com/users/kescobo/events{/privacy}","received_events_url":"https://api.github.com/users/kescobo/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-11T14:39:51Z","updated_at":"2026-03-02T15:38:03Z","body":"## Review checklist for @kescobo\n\n### Conflict of interest\n\n- [x] I confirm that I have read the [JOSS conflict of interest (COI) policy](https://github.com/openjournals/joss/blob/main/COI.md) and that: I have no COIs with reviewing this work or that any perceived COIs have been waived by JOSS for the purpose of this review.\n\n### Code of Conduct\n\n- [x] I confirm that I read and will adhere to the [JOSS code of conduct](https://github.com/openjournals/joss/blob/main/CODE_OF_CONDUCT.md).\n\n### General checks\n\n- [x] **Repository:** Is the source code for this software available at the [https://github.com/TARGENE/targene-pipeline](https://github.com/TARGENE/targene-pipeline)?\n- [x] **License:** Does the repository contain a plain-text LICENSE or COPYING file with the contents of an [OSI approved](https://opensource.org/licenses/alphabetical) software license?\n- [x] **Contribution and authorship:** Has the submitting author (@olivierlabayle) made major contributions to the software? Does the full list of paper authors seem appropriate and complete?\n- [x] **Substantial scholarly effort:** Does this submission meet the scope eligibility described in the [JOSS guidelines](https://joss.readthedocs.io/en/pre-2026-submission/submitting.html#substantial-scholarly-effort)\n- [x] **Data sharing:** If the paper contains original data, data are accessible to the reviewers. If the paper contains no original data, please check this item.\n- [x] **Reproducibility:** If the paper contains original results, results are entirely reproducible by reviewers. If the paper contains no original results, please check this item.\n- [x] **Human and animal research:** If the paper contains original data research on humans subjects or animals, does it comply with [JOSS's human participants research policy and/or animal research policy](https://joss.readthedocs.io/en/pre-2026-submission/policies.html?highlight=animal#joss-policies)? If the paper contains no such data, please check this item.\n\n\n### Functionality\n\n- [x] **Installation:** Does installation proceed as outlined in the documentation?\n- [x] **Functionality:** Have the functional claims of the software been confirmed?\n- [x] **Performance:** If there are any performance claims of the software, have they been confirmed? (If there are no claims, please check off this item.)\n\n### Documentation\n\n- [x] **A statement of need**: Do the authors clearly state what problems the software is designed to solve and who the target audience is?\n- [x] **Installation instructions:** Is there a clearly-stated list of dependencies? Ideally these should be handled with an automated package management solution.\n- [x] **Example usage:** Do the authors include examples of how to use the software (ideally to solve real-world analysis problems).\n- [x] **Functionality documentation:** Is the core functionality of the software documented to a satisfactory level (e.g., API method documentation)?\n- [x] **Automated tests:** Are there automated tests or manual steps described so that the functionality of the software can be verified?\n- [x] **Community guidelines:** Are there clear guidelines for third parties wishing to 1. Contribute to the software 2. Report issues or problems with the software 3. Seek support\n\n### Software paper\n\n- [x] **Summary:** Has a clear description of the high-level functionality and purpose of the software for a diverse, non-specialist audience been provided?\n- [x] **A statement of need:** Does the paper have a section titled 'Statement of need' that clearly states what problems the software is designed to solve, who the target audience is, and its relation to other work?\n- [x] **State of the field:** Do the authors describe how this software compares to other commonly-used packages?\n- [x] **Quality of writing:** Is the paper well written (i.e., it does not require editing for structure, language, or writing quality)?\n- [x] **References:** Is the list of references complete, and is everything cited appropriately that should be cited (e.g., papers, datasets, software)? Do references in the text use the proper [citation syntax](https://pandoc.org/MANUAL.html#extension-citations)?\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3642243328/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3656838541","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3656838541","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3656838541,"node_id":"IC_kwDOAx6EUs7Z9u2N","user":{"login":"ZeyuanSong","id":51000742,"node_id":"MDQ6VXNlcjUxMDAwNzQy","avatar_url":"https://avatars.githubusercontent.com/u/51000742?v=4","gravatar_id":"","url":"https://api.github.com/users/ZeyuanSong","html_url":"https://github.com/ZeyuanSong","followers_url":"https://api.github.com/users/ZeyuanSong/followers","following_url":"https://api.github.com/users/ZeyuanSong/following{/other_user}","gists_url":"https://api.github.com/users/ZeyuanSong/gists{/gist_id}","starred_url":"https://api.github.com/users/ZeyuanSong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ZeyuanSong/subscriptions","organizations_url":"https://api.github.com/users/ZeyuanSong/orgs","repos_url":"https://api.github.com/users/ZeyuanSong/repos","events_url":"https://api.github.com/users/ZeyuanSong/events{/privacy}","received_events_url":"https://api.github.com/users/ZeyuanSong/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-12-15T17:36:44Z","updated_at":"2026-02-18T16:17:50Z","body":"## Review checklist for @ZeyuanSong\n\n### Conflict of interest\n\n- [x] I confirm that I have read the [JOSS conflict of interest (COI) policy](https://github.com/openjournals/joss/blob/main/COI.md) and that: I have no COIs with reviewing this work or that any perceived COIs have been waived by JOSS for the purpose of this review.\n\n### Code of Conduct\n\n- [x] I confirm that I read and will adhere to the [JOSS code of conduct](https://github.com/openjournals/joss/blob/main/CODE_OF_CONDUCT.md).\n\n### General checks\n\n- [x] **Repository:** Is the source code for this software available at the [https://github.com/TARGENE/targene-pipeline](https://github.com/TARGENE/targene-pipeline)?\n- [x] **License:** Does the repository contain a plain-text LICENSE or COPYING file with the contents of an [OSI approved](https://opensource.org/licenses/alphabetical) software license?\n- [x] **Contribution and authorship:** Has the submitting author (@olivierlabayle) made major contributions to the software? Does the full list of paper authors seem appropriate and complete?\n- [x] **Substantial scholarly effort:** Does this submission meet the scope eligibility described in the [JOSS guidelines](https://joss.readthedocs.io/en/pre-2026-submission/submitting.html#substantial-scholarly-effort)\n- [x] **Data sharing:** If the paper contains original data, data are accessible to the reviewers. If the paper contains no original data, please check this item.\n- [x] **Reproducibility:** If the paper contains original results, results are entirely reproducible by reviewers. If the paper contains no original results, please check this item.\n- [x] **Human and animal research:** If the paper contains original data research on humans subjects or animals, does it comply with [JOSS's human participants research policy and/or animal research policy](https://joss.readthedocs.io/en/pre-2026-submission/policies.html?highlight=animal#joss-policies)? If the paper contains no such data, please check this item.\n\n\n### Functionality\n\n- [x] **Installation:** Does installation proceed as outlined in the documentation?\n- [x] **Functionality:** Have the functional claims of the software been confirmed?\n- [x] **Performance:** If there are any performance claims of the software, have they been confirmed? (If there are no claims, please check off this item.)\n\n### Documentation\n\n- [x] **A statement of need**: Do the authors clearly state what problems the software is designed to solve and who the target audience is?\n- [x] **Installation instructions:** Is there a clearly-stated list of dependencies? Ideally these should be handled with an automated package management solution.\n- [x] **Example usage:** Do the authors include examples of how to use the software (ideally to solve real-world analysis problems).\n- [x] **Functionality documentation:** Is the core functionality of the software documented to a satisfactory level (e.g., API method documentation)?\n- [x] **Automated tests:** Are there automated tests or manual steps described so that the functionality of the software can be verified?\n- [x] **Community guidelines:** Are there clear guidelines for third parties wishing to 1. Contribute to the software 2. Report issues or problems with the software 3. Seek support\n\n### Software paper\n\n- [x] **Summary:** Has a clear description of the high-level functionality and purpose of the software for a diverse, non-specialist audience been provided?\n- [x] **A statement of need:** Does the paper have a section titled 'Statement of need' that clearly states what problems the software is designed to solve, who the target audience is, and its relation to other work?\n- [x] **State of the field:** Do the authors describe how this software compares to other commonly-used packages?\n- [x] **Quality of writing:** Is the paper well written (i.e., it does not require editing for structure, language, or writing quality)?\n- [x] **References:** Is the list of references complete, and is everything cited appropriately that should be cited (e.g., papers, datasets, software)? Do references in the text use the proper [citation syntax](https://pandoc.org/MANUAL.html#extension-citations)?\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3656838541/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3719067462","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3719067462","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3719067462,"node_id":"IC_kwDOAx6EUs7drHdG","user":{"login":"arfon","id":4483,"node_id":"MDQ6VXNlcjQ0ODM=","avatar_url":"https://avatars.githubusercontent.com/u/4483?v=4","gravatar_id":"","url":"https://api.github.com/users/arfon","html_url":"https://github.com/arfon","followers_url":"https://api.github.com/users/arfon/followers","following_url":"https://api.github.com/users/arfon/following{/other_user}","gists_url":"https://api.github.com/users/arfon/gists{/gist_id}","starred_url":"https://api.github.com/users/arfon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arfon/subscriptions","organizations_url":"https://api.github.com/users/arfon/orgs","repos_url":"https://api.github.com/users/arfon/repos","events_url":"https://api.github.com/users/arfon/events{/privacy}","received_events_url":"https://api.github.com/users/arfon/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-07T14:10:44Z","updated_at":"2026-01-07T17:23:34Z","body":"👋 This review issue has been updated to reflect JOSS's revised scope policies.\n\n**What changed**\n\n- Documentation links in the reviewer checklist now point to the archived pre-2026 documentation at https://joss.readthedocs.io/en/pre-2026-submission/\n- This ensures the review guidelines match the scope under which this submission was received (this submission is being reviewed by the JOSS criteria before this scope update was made on [5th January 2026](https://blog.joss.theoj.org/2026/01/preparing-joss-for-a-generative-ai-future))\n\n**Important context**\n\nJOSS recently updated its scope to address challenges posed by generative AI (see our [blog post](https://blog.joss.theoj.org/2026/01/preparing-joss-for-a-generative-ai-future) for details). However, **this submission is being reviewed under the previous scope** and should be reviewed according to those guidelines.\n\nThe reviewer documentation that matches the review criteria for this historical submission can be found here: https://joss.readthedocs.io/en/pre-2026-submission/reviewer_guidelines.html\n\nAny questions, please direct them at the editor of this submission. Many thanks!\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3719067462/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3726123299","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3726123299","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3726123299,"node_id":"IC_kwDOAx6EUs7eGCEj","user":{"login":"ZeyuanSong","id":51000742,"node_id":"MDQ6VXNlcjUxMDAwNzQy","avatar_url":"https://avatars.githubusercontent.com/u/51000742?v=4","gravatar_id":"","url":"https://api.github.com/users/ZeyuanSong","html_url":"https://github.com/ZeyuanSong","followers_url":"https://api.github.com/users/ZeyuanSong/followers","following_url":"https://api.github.com/users/ZeyuanSong/following{/other_user}","gists_url":"https://api.github.com/users/ZeyuanSong/gists{/gist_id}","starred_url":"https://api.github.com/users/ZeyuanSong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ZeyuanSong/subscriptions","organizations_url":"https://api.github.com/users/ZeyuanSong/orgs","repos_url":"https://api.github.com/users/ZeyuanSong/repos","events_url":"https://api.github.com/users/ZeyuanSong/events{/privacy}","received_events_url":"https://api.github.com/users/ZeyuanSong/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-08T22:34:58Z","updated_at":"2026-01-08T22:34:58Z","body":"In the User Guide, the authors provide four usage examples (GWAS, PheWAS, Interaction Study, and All of Us). However, in each section, the example command ends with\nnextflow run https://github.com/TARGENE/targene-pipeline -r v0.11.1 -profile local,\nwhich is not directly runnable as written. Additional configuration files, inputs, and environment setup are required before the pipeline can be executed successfully.\n\nI recommend that the authors include step-by-step, fully runnable example scripts for each use case. These should clearly document (i) the expected structure and contents of the input files, (ii) the exact Nextflow command(s) required to launch the workflow, (iii) what users should observe during pipeline execution, and (iv) the generated output files along with guidance on how to interpret them. Ideally, these example scripts should run end-to-end after cloning the repository and installing the documented dependencies. Without such concrete, executable examples, reproducing the analyses and adopting the software may be unnecessarily difficult for other researchers.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3726123299/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3745282314","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3745282314","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3745282314,"node_id":"IC_kwDOAx6EUs7fPHkK","user":{"login":"olivierlabayle","id":48188914,"node_id":"MDQ6VXNlcjQ4MTg4OTE0","avatar_url":"https://avatars.githubusercontent.com/u/48188914?v=4","gravatar_id":"","url":"https://api.github.com/users/olivierlabayle","html_url":"https://github.com/olivierlabayle","followers_url":"https://api.github.com/users/olivierlabayle/followers","following_url":"https://api.github.com/users/olivierlabayle/following{/other_user}","gists_url":"https://api.github.com/users/olivierlabayle/gists{/gist_id}","starred_url":"https://api.github.com/users/olivierlabayle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/olivierlabayle/subscriptions","organizations_url":"https://api.github.com/users/olivierlabayle/orgs","repos_url":"https://api.github.com/users/olivierlabayle/repos","events_url":"https://api.github.com/users/olivierlabayle/events{/privacy}","received_events_url":"https://api.github.com/users/olivierlabayle/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-13T16:31:45Z","updated_at":"2026-01-13T16:31:45Z","body":"Thank you for the feedback @ZeyuanSong. Indeed, the documentation did not make a great job at pointing out that the configuration file had to be modified. I have updated the examples to take your comments into account.\n\n(i) The setup page hopefully provides enough information for anyone to get started.\n(ii) Each example explicitly refers to this setup page where the inputs are described. All input files are contained within the repository and can be freely investigated.\n(iii) The exact Nextflow command is provided in each example together with the 1 or 2 files that have to be written by the user (the content is also given).\n(iv) A description of the outputs is provided and a link to the more general description in the user guide is also always given.\n\nThe exception is the All of Us example since we do not have mock data for it. It is explicitly mentionned that this is more of a general description on how to  setup the pipeline now.\n\nAs a reference the updated documentation is available here: https://targene.github.io/targene-pipeline/previews/PR219/examples/setup/ the general PR for this review is https://github.com/TARGENE/targene-pipeline/pull/219","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3745282314/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/openjournals/joss-reviews/issues/comments/3764390986","html_url":"https://github.com/openjournals/joss-reviews/issues/9603#issuecomment-3764390986","issue_url":"https://api.github.com/repos/openjournals/joss-reviews/issues/9603","id":3764390986,"node_id":"IC_kwDOAx6EUs7gYAxK","user":{"login":"abhishektiwari","id":363839,"node_id":"MDQ6VXNlcjM2MzgzOQ==","avatar_url":"https://avatars.githubusercontent.com/u/363839?v=4","gravatar_id":"","url":"https://api.github.com/users/abhishektiwari","html_url":"https://github.com/abhishektiwari","followers_url":"https://api.github.com/users/abhishektiwari/followers","following_url":"https://api.github.com/users/abhishektiwari/following{/other_user}","gists_url":"https://api.github.com/users/abhishektiwari/gists{/gist_id}","starred_url":"https://api.github.com/users/abhishektiwari/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abhishektiwari/subscriptions","organizations_url":"https://api.github.com/users/abhishektiwari/orgs","repos_url":"https://api.github.com/users/abhishektiwari/repos","events_url":"https://api.github.com/users/abhishektiwari/events{/privacy}","received_events_url":"https://api.github.com/users/abhishektiwari/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-17T22:00:59Z","updated_at":"2026-01-17T22:00:59Z","body":"Happy new year @ZeyuanSong and  @kescobo. How are you progressing with review?","author_association":"MEMBER","pin":null,"reactions":{"url