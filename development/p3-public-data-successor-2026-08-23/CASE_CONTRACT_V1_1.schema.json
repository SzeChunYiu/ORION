          },
          "type": "object"
        },
        "entity_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedness": {
          "additionalProperties": {
            "enum": [
              "OBSERVED",
              "NOT_OBSERVED",
              "UNRESOLVED"
            ]
