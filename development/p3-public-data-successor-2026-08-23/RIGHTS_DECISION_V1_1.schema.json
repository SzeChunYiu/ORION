{
  "$id": "orion.p3.public-rights-decision.v1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_classes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "decided_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "decided_by": {
      "minLength": 1,
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "license_evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "non_legal_advice_acknowledged": {
      "const": true
    },
    "permitted_operations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "redistribution_plan": {
      "minLength": 1,
      "type": "string"
    },
    "required_conditions_acknowledged": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "orion.p3.public-rights-decision.v1.1"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "terminal": {
      "enum": [
        "AUTHORIZED_FOR_DECLARED_RESEARCH_OPERATIONS",
        "DENIED",
        "CANNOT_CHECK"
      ]
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "source_id",
    "decided_by",
    "decided_at_utc",
    "permitted_operations",
    "content_classes",
    "license_evidence",
    "required_conditions_acknowledged",
    "redistribution_plan",
    "terminal",
    "non_legal_advice_acknowledged"
  ],
  "title": "Human-owned public-source content rights decision",
  "type": "object"
}
