\r\n- Fix linting makefile #521\r\n\r\n# Documentation\r\n\r\n- Add snippets for linting and testing #525\r\n- Update references and citations #528\r\n- Update REFERENCES.md with new conference details #530\r\n- Add mdsplus warning to docs #529\r\n\r\n# Dependencies\r\n\r\n- Update deps to Feb 2026 #526\r\n\r\n### Changelog\r\n\r\nhttps://github.com/MIT-PSFC/disruption-py/compare/v0.13...v0.14"},{"url":"https://api.github.com/repos/MIT-PSFC/disruption-py/releases/285336293","assets_url":"https://api.github.com/repos/MIT-PSFC/disruption-py/releases/285336293/assets","upload_url":"https://uploads.github.com/repos/MIT-PSFC/disruption-py/releases/285336293/assets{?name,label}","html_url":"https://github.com/MIT-PSFC/disruption-py/releases/tag/v0.13","id":285336293,"author":{"login":"gtrevisan","id":20228269,"node_id":"MDQ6VXNlcjIwMjI4MjY5","avatar_url":"https://avatars.githubusercontent.com/u/20228269?v=4","gravatar_id":"","url":"https://api.github.com/users/gtrevisan","html_url":"https://github.com/gtrevisan","followers_url":"https://api.github.com/users/gtrevisan/followers","following_url":"https://api.github.com/users/gtrevisan/following{/other_user}","gists_url":"https://api.github.com/users/gtrevisan/gists{/gist_id}","starred_url":"https://api.github.com/users/gtrevisan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gtrevisan/subscriptions","organizations_url":"https://api.github.com/users/gtrevisan/orgs","repos_url":"https://api.github.com/users/gtrevisan/repos","events_url":"https://api.github.com/users/gtrevisan/events{/privacy}","received_events_url":"https://api.github.com/users/gtrevisan/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOGgdW9s4RAeLl","tag_name":"v0.13","target_commitish":"main","name":"v0.13.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-02-11T16:41:42Z","updated_at":"2026-02-11T16:48:52Z","published_at":"2026-02-11T16:48:52Z","assets":[],"tarbal