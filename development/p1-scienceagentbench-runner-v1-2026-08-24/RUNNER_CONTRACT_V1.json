  "production_cli": {
    "module": "sab_verified_runner_v1.py",
    "commands": {
      "validate-bindings": {
        "purpose": "Validate the pinned input identity and a fully bound matched run plan without generating candidates.",
        "required_arguments": [
          "--split verified",
          "--parquet PATH",
          "--mask-manifest PATH",
          "--run-plan PATH",
          "--output PATH"
        ]
      },
      "seal-candidates": {
        "purpose": "Validate and content-seal the complete 102 x 3 x 3 candidate ledger after generation and before any evaluator command is emitted.",
        "required_arguments": [
          "--split verified",
          "--parquet PATH",
          "--mask-manifest PATH",
          "--run-plan PATH",
          "--candidate-ledger PATH",
          "--output PATH"
        ]
      },
      "emit-evaluator-command": {
        "purpose": "Emit one inert official evaluator argv receipt for a named arm and attempt after complete-ledger sealing; never invoke it.",
        "required_arguments": [
          "--split verified",
          "--seal-receipt PATH",
          "--official-repo-root PATH",
          "--benchmark-path PATH",
          "--pred-program-path PATH",
          "--log-fname PATH",
          "--arm {RR,OS,NR}",
          "--attempt {1,2,3}",
          "--run-id TEXT",
          "--output PATH"
        ]
      }
    },
    "constant_override_arguments_forbidden": [
      "expected parquet digest",
      "expected mask digest",
      "expected task IDs",
      "arm set",
      "attempt count",
      "official source commit",
      "evaluator module"
    ],
    "split_rule": "--split is required to make intent explicit, but only the immutable value verified is accepted; omission, validation, and every other value fail closed."
  },
