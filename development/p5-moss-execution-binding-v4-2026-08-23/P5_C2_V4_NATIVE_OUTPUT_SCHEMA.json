{
  "$id": "orion.p5.c2.moss-native-terminal.v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_disposition": {
      "properties": {
        "output": {
          "const": "UNRESOLVED"
        },
        "raw_native_singleton_licensed": {
          "const": false
        }
      },
      "required": [
        "output",
        "raw_native_singleton_licensed"
      ],
      "type": "object"
    },
    "arm_id": {
      "const": "C2_DIRECT_SELF_EDIT__MOSS"
    },
    "native_retention": {
      "type": "object"
    },
    "native_terminal": {
      "properties": {
        "arm_id": {
          "const": "C2_DIRECT_SELF_EDIT__MOSS"
        },
        "native_code": {
          "enum": [
            "initialized",
            "in_progress",
            "swap_pending",
            "converged",
            "rolled_back",
            "failed",
            "aborted_max_iter",
            "aborted_streak"
          ]
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE_SUCCESS",
            "ERROR",
            "TIMEOUT",
            "ABSTAIN",
            "EMPTY",
            "PARTIAL",
            "INVALID"
          ]
        }
      },
      "required": [
        "arm_id",
        "status",
        "native_code",
        "payload_sha256"
      ],
      "type": "object"
    },
    "outcome_boundary": {
      "type": "object"
    },
    "schema_version": {
      "const": "orion.p5.c2.moss-native-terminal.v4"
    },
    "source": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "arm_id",
    "source",
    "native_terminal",
    "native_retention",
    "adapter_disposition",
    "outcome_boundary"
  ],
  "type": "object"
}
